{
  "name": "Plan Financiero Quincenal",
  "short_name": "Finanzas",
  "description": "Saber si te alcanza para pagar tu tarjeta y controlar tus gastos contra tu sueldo.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#090e18",
  "theme_color": "#090e18",
  "orientation": "portrait",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./compartir-mandado",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "archivo",
          "accept": ["application/json", ".json", "text/plain"]
        }
      ]
    }
  },
  "categories": ["finance", "productivity"],
  "lang": "es-MX"
}
